    { "id": "gpt-6.1-sol", "name": "GPT-6.1 Sol", "meta": { "description": "CLIProxy · ChatGPT(Codex) 구독" } },
    { "id": "gpt-6.1-terra", "name": "GPT-6.1 Terra", "meta": { "description": "CLIProxy · ChatGPT(Codex) 구독" } },

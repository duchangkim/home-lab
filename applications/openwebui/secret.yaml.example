# Example secret file
# Copy this to secret.yaml and fill in your actual values
# Then encrypt with: kubeseal -f secret.yaml -w sealed-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: openwebui-secret
  namespace: default
type: Opaque
stringData:
  webui-secret-key: "your-secret-key-here"
  # openai-api-key: "sk-xxxxxxxxxxxxx"
  openrouter-api-key: "sk-or-v1-xxxxxxxxxxxxx"
  # CLIProxyAPI 클라이언트 키 (cli-proxy-api-secret의 api-key-openwebui와 같은 값)
  cli-proxy-api-key: "<openssl rand -hex 32>"

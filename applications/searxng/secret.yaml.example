# Copy this to secret.yaml and fill in your actual values
# Then encrypt with: kubeseal --cert=pub-cert.pem -f secret.yaml -w sealed-secret.yaml --format yaml
apiVersion: v1
kind: Secret
metadata:
  name: searxng-secret
  namespace: default
type: Opaque
stringData:
  # SearXNG server.secret_key (재생성해도 무방: 세션·이미지 프록시 서명용)
  secret-key: "<openssl rand -hex 32>"

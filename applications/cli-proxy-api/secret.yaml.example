apiVersion: v1
kind: Secret
metadata:
  name: cli-proxy-api-secret
  namespace: default
type: Opaque
stringData:
  # 관리 UI(/management.html) 로그인 키
  management-key: "<openssl rand -hex 32>"
  # OpenWebUI가 사용하는 클라이언트 API 키 (openwebui-secret의 cli-proxy-api-key와 같은 값)
  api-key-openwebui: "<openssl rand -hex 32>"
  # Tailscale로 접속하는 개인 클라이언트용 API 키
  api-key-personal: "<openssl rand -hex 32>"
  # (선택) Tailscale auth key. 비워 두면 tailscale 컨테이너 로그에 로그인 URL이 출력된다.
  # ts-authkey: "tskey-auth-..."
